# Copy to .env (repo root) and fill in. Never commit .env.

# Neon PostgreSQL — use the DIRECT (non "-pooler") connection strings, with sslmode=require.
# Database names come only from here (e.g. neondb / smart_transit and smart_transit_test).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST/smart_transit_test?sslmode=require"

# API
PORT=4000
WEB_ORIGIN="http://localhost:3000"
JWT_SECRET="change-me-to-a-long-random-string"
OPERATOR_EMAIL="operator@smart-transit.az"
OPERATOR_PASSWORD="change-me"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
